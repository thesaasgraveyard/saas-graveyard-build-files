<?xml version="1.0" encoding="utf-8" ?>
<!--
    PlaylistLoader — runs on a background thread.
    Fetches the Google Apps Script JSON and returns a clean array.
    Network I/O MUST be on a Task thread in Roku SceneGraph.
-->
<component name="PlaylistLoader" extends="Task">
    <interface>
        <field id="url"    type="string" alwaysNotify="true"/>
        <field id="result" type="array"  alwaysNotify="true"/>
    </interface>
    <script type="text/brightscript" uri="PlaylistLoader.brs"/>
</component>
